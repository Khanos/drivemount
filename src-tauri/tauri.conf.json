{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriveMount",
  "version": "0.1.1",
  "identifier": "io.github.drivemount.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DriveMount",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Google Drive in your Linux files",
    "longDescription": "A friendly, independent Google Drive connection manager powered by rclone. Files are fetched on demand; this is not an offline synchronization client.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "librsvg2-2",
          "systemd",
          "util-linux",
          "xdg-utils",
          "policykit-1"
        ],
        "recommends": [
          "rclone",
          "fuse3"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "librsvg2",
          "systemd",
          "util-linux",
          "xdg-utils",
          "polkit"
        ],
        "recommends": [
          "rclone",
          "fuse3"
        ]
      }
    }
  }
}
